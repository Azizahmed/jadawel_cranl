# Template only — every value below must be replaced before this file is used.
#
# These were real-looking values (`SECRET_KEY=jadawel` and so on), and the
# compose override beside this file tells you to `cp .env.testing .env`, so a
# deployment that followed the instructions ran on a published secret. Generate
# each one instead:
#
#   openssl rand -hex 32
#
REPLACE_ME=set-the-four-values-below-before-starting-the-stack
SECRET_KEY=
JADAWEL_JWT_SIGNING_KEY=
DATABASE_PASSWORD=
REDIS_PASSWORD=
JADAWEL_PUBLIC_URL=http://example.localhost
