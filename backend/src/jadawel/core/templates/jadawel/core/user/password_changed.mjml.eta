<% layout("../../base.layout.eta") %>

<mj-section>
  <mj-column>
    <mj-text mj-class="title">{% trans "Password changed" %}</mj-text>
    <mj-text mj-class="text">
      {% blocktrans trimmed with user.username as username and jadawel_embedded_share_hostname as jadawel_embedded_share_hostname %}
        The password for your account ({{ username }}) on
        جداول ({{ jadawel_embedded_share_hostname }}) has been successfully changed.
      {% endblocktrans %}
    </mj-text>
    <mj-text mj-class="text">
      {% blocktrans trimmed %}
        If you did not make this change, please contact your administrator immediately
        to secure your account.
      {% endblocktrans %}
    </mj-text>
    <mj-raw><!-- htmlmin:ignore -->{% if show_jadawel_description %}<!-- htmlmin:ignore --></mj-raw>
      <mj-text mj-class="text">
        {% blocktrans trimmed %}
          جداول is an Arabic-first online database and spreadsheet tool that lets your team collaborate on projects, customers and more.
        {% endblocktrans %}
      </mj-text>
    <mj-raw><!-- htmlmin:ignore -->{% endif %}<!-- htmlmin:ignore --></mj-raw>
  </mj-column>
</mj-section>
